        </mxCell>

        <!-- Módulos - primera fila (roles bajos) -->
        <mxCell id="mod_stock" value="📊 Stock Real&#10;&#10;Roles: TODOS&#10;&#10;SELECT PRODUCTO,&#10;SUM(CASE WHEN tipo IN&#10;('INGRESO','AJUSTE')&#10;THEN peso ELSE -peso END)&#10;FROM movimientos&#10;GROUP BY PRODUCTO" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d0e0e3;strokeColor=#6d8db4;fontSize=10;verticalAlign=top;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="920" width="220" height="180" as="geometry" />
        </mxCell>

        <mxCell id="mod_reg" value="📝 Registrar Movimiento&#10;&#10;Roles: OPERADOR+&#10;&#10;Formulario dinámico:&#10;• INGRESO/AJUSTE → CAVA INTERNA&#10;• SALIDA POR DESPACHO → almacén&#10;   + remisión&#10;• MERMA → DESPERDICIO&#10;&#10;Valida tipo/peso/producto&#10;INSERT en movimientos&#10;+ historial_movimiento(CREAR)&#10;+ log_actividad" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d0e0e3;strokeColor=#6d8db4;fontSize=10;verticalAlign=top;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="920" width="220" height="280" as="geometry" />
        </mxCell>

        <mxCell id="mod_hist" value="📋 Historial y Reportes&#10;&#10;Roles: TODOS&#10;&#10;• Tabla completa movimientos&#10;• Selección de fila →&#10;   historial de cambios del ID&#10;• Descarga Excel&#10;   (openpyxl / BytesIO)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d0e0e3;strokeColor=#6d8db4;fontSize=10;verticalAlign=top;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="920" width="220" height="180" as="geometry" />
        </mxCell>

        <!-- Módulos - segunda fila (Admin+) -->
        <mxCell id="mod_admin" value="🛠️ Gestión de Registros&#10;&#10;Roles: ADMIN / SUPER ADMIN&#10;&#10;• Editar movimiento&#10;   → diff campo a campo&#10;   → historial_movimiento(ACTUALIZAR)&#10;• Eliminar movimiento&#10;   → historial_movimiento(ELIMINAR)&#10;   antes del DELETE" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d0e0e3;strokeColor=#6d8db4;fontSize=10;verticalAlign=top;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="1220" width="220" height="220" as="geometry" />
        </mxCell>

        <mxCell id="mod_cat" value="📦 Catálogo de Productos&#10;&#10;Roles: ADMIN / SUPER ADMIN&#10;&#10;• Crear producto (UNIQUE nombre)&#10;• Renombrar producto&#10;   → cascada a movimientos&#10;• Eliminar producto&#10;   BLOQUEADO si hay movimientos&#10;   asociados (integridad lógica)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d0e0e3;strokeColor=#6d8db4;fontSize=10;verticalAlign=top;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="1220" width="220" height="220" as="geometry" />
        </mxCell>

        <!-- Módulos - tercera fila (Super Admin) -->
        <mxCell id="mod_stats" value="📊 Estadísticas de uso&#10;&#10;Rol: SUPER ADMIN&#10;&#10;KPIs:&#10;• Ingresos por usuario&#10;• Eventos de log por día&#10;• Movimientos por usuario/tipo/día&#10;• Últimos 400 eventos&#10;&#10;Fuentes: log_actividad + movimientos" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d0e0e3;strokeColor=#6d8db4;fontSize=10;verticalAlign=top;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1220" width="220" height="220" as="geometry" />
        </mxCell>

        <mxCell id="mod_users" value="⚙️ Gestión de Usuarios&#10;&#10;Rol: SUPER ADMIN&#10;&#10;CRUD sobre usuarios&#10;• ID inmutable (trazabilidad)&#10;• Password vacío = conservar&#10;• Auto-borrado BLOQUEADO&#10;   (id ≠ session.user_id)&#10;• Roles: Consulta / Operador /&#10;   Administrador / Super Admin" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d0e0e3;strokeColor=#6d8db4;fontSize=10;verticalAlign=top;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1220" width="220" height="220" as="geometry" />
