        <mxCell id="ddl_note" value="⚠ DDL IDEMPOTENTE:&#10;ensure_historial_movimiento_table() y&#10;ensure_catalogo_productos_table() +&#10;seed_catalogo_productos_si_vacio()&#10;se ejecutan de forma perezosa al&#10;primer uso, permitiendo despliegues&#10;contra bases limpias." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
