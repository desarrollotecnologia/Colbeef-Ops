# Copiar a .env y completar valores
DATABASE_URL="mysql://usuario:password@localhost:3306/colbeef_ops"
JWT_SECRET="cambiar-por-un-secreto-seguro-largo"
JWT_EXPIRES_IN="8h"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# SIRT / trazabilidad (Postgres) — lectura para Verificación PCC
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Opcional: hora de cierre del turno PCC en Bogotá (default 7)
# VERIFICACION_PCC_TURNO_HORA_FIN=7
